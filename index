    {label:'Type',key:'type',fmt:s=>s.type},
    {label:'Ranking',key:'ranking',fmt:s=>`<strong>${s.ranking}</strong>`},
    {label:'Selectivity',key:'sel',fmt:s=>`<div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:${s.selectivity}%"></div></div><span style="font-size:.8rem;color:var(--gray)">${s.selectivity}%</span></div>`},
    {label:'Avg. Starting Salary',key:'salary',fmt:s=>`<strong style="color:var(--gold)">€${s.salary.toLocaleString()}</strong>`},
    {label:'Specialities',key:'spec',fmt:s=>`<span style="font-size:.82rem;color:var(--gray)">${s.specialities}</span>`},
  ];
  t.innerHTML=`<thead><tr><th>Criterion</th>${sel.map(s=>`<th>${s.name}</th>`).join('')}</tr></thead>
  <tbody>${rows.map(r=>`<tr><td><strong style="font-size:.82rem;font-family:'DM Mono',monospace;letter-spacing:.05em">${r.label}</strong></td>${sel.map(s=>`<td>${r.fmt(s)}</td>`).join('')}</tr>`).join('')}</tbody>`;
}

// ══════════════════════════════════════
// SALARY CALCULATOR
// ══════════════════════════════════════
function updateSalary(){
  const field=document.getElementById('salField').value;
  const tier=document.getElementById('salTier').value;
  const exp=parseInt(document.getElementById('salExp').value);
  const loc=document.getElementById('salLoc').value;
  const base=salaryData.base[field];
  const calc=Math.round(base * salaryData.tier[tier] * salaryData.exp(exp) * salaryData.loc[loc]);
  const low=Math.round(calc*0.88);
  const high=Math.round(calc*1.15);
  document.getElementById('salAmount').textContent='€'+calc.toLocaleString();
  document.getElementById('salDesc').textContent=`Estimated gross annual salary · ${exp===0?'Entry level':exp+' years experience'}`;
  document.getElementById('salRangeText').textContent=`Typical range: €${(low/1000).toFixed(0)}k – €${(high/1000).toFixed(0)}k`;
}

// ══════════════════════════════════════
// CALENDAR
// ══════════════════════════════════════
function buildCalendar(){
  const now=new Date();
  document.getElementById('eventsList').innerHTML=events.map(e=>{
    const eDate=new Date(`${e.month} ${e.day} ${e.year}`);
    const diff=Math.ceil((eDate-now)/(1000*60*60*24));
    let badge='',bClass='';
    if(diff<0){badge=`Past`;bClass='past';}
    else if(diff<30){badge=`In ${diff} days`;bClass='soon';}
    else if(diff<60){badge=`In ${Math.ceil(diff/7)} weeks`;bClass='soon';}
    else{badge=`${e.month} ${e.year}`;bClass='';}
    return `<div class="event-item">
      <div class="event-date-box">
        <div class="event-month">${e.month}</div>
        <div class="event-day">${e.day}</div>
        <div class="event-year">${e.year}</div>
      </div>
      <div class="event-info"><h4>${e.title}</h4><p>${e.desc}</p></div>
      <div class="countdown-badge ${bClass}">${badge}</div>
    </div>`;
  }).join('');
}

// ══════════════════════════════════════
// CHECKLIST
// ══════════════════════════════════════
let checkState={};
function buildChecklist(){
  const saved=JSON.parse(localStorage.getItem('checklist')||'{}');
  checkState=saved;
  const wrap=document.getElementById('checkCategories');
  wrap.innerHTML=checklistData.map((cat,ci)=>`
    <div class="check-cat">
      <div class="check-cat-header" onclick="toggleCat(${ci})">
        <span class="check-cat-icon">${cat.cat.split(' ')[0]}</span>
        <span class="check-cat-title">${cat.cat.slice(cat.cat.indexOf(' ')+1)}</span>
        <span class="check-cat-count" id="catCount${ci}"></span>
      </div>
      <div class="check-items" id="catItems${ci}">
        ${cat.items.map((item,ii)=>{
          const key=`${ci}-${ii}`;
          const checked=checkState[key];
          return `<div class="check-item${checked?' done':''}" id="ci${ci}-${ii}">
            <div class="check-box${checked?' checked':''}" onclick="toggleCheck(${ci},${ii})" id="cb${ci}-${ii}"></div>
            <span class="check-label">${item}</span>
          </div>`;
        }).join('')}
      </div>
    </div>`).join('');
  updateProgress();
}
function toggleCat(ci){
  const items=document.getElementById(`catItems${ci}`);
  items.style.display=items.style.display==='none'?'block':'none';
}
function toggleCheck(ci,ii){
  const key=`${ci}-${ii}`;
  checkState[key]=!checkState[key];
  localStorage.setItem('checklist',JSON.stringify(checkState));
  const box=document.getElementById(`cb${ci}-${ii}`);
  const item=document.getElementById(`ci${ci}-${ii}`);
  box.classList.toggle('checked',checkState[key]);
  item.classList.toggle('done',checkState[key]);
  updateProgress();
}
function updateProgress(){
  const total=checklistData.reduce((a,c)=>a+c.items.length,0);
  const done=Object.values(checkState).filter(Boolean).length;
  document.getElementById('progressFill').style.width=`${(done/total)*100}%`;
  document.getElementById('progressText').textContent=`${done} / ${total} tasks completed`;
  checklistData.forEach((cat,ci)=>{
    const catDone=cat.items.filter((_,ii)=>checkState[`${ci}-${ii}`]).length;
    document.getElementById(`catCount${ci}`).textContent=`${catDone}/${cat.items.length}`;
  });
}


let current=0, answers=[], quizProfile=null;

function getProfile(a){
  const c={tech:0,env:0,digital:0,bio:0};
  a.forEach(v=>{
    if(["tech","global","innov","abroad","phd"].includes(v))c.tech++;
    if(["env","local","field"].includes(v))c.env++;
    if(["digital","desk","startup"].includes(v))c.digital++;
    if(["bio","research","strat","france"].includes(v))c.bio++;
  });
  const mx=Object.entries(c).sort((a,b)=>b[1]-a[1])[0][0];
  return {tech:'aerospace',env:'environment',digital:'digital',bio:'biomedical'}[mx];
}

function renderSteps(){
  const ind=document.getElementById('stepIndicator'); ind.innerHTML='';
  for(let i=0;i<questions.length;i++){
    const d=document.createElement('div');
    d.className='step-dot'+(i<current?' done':i===current?' active':'');
    d.textContent=i<current?'✓':i+1; ind.appendChild(d);
    if(i<questions.length-1){const l=document.createElement('div');l.className='step-line';ind.appendChild(l);}
  }
}

function renderQuestion(){
  const q=questions[current],s=answers[current];
  // restore saved
  const saved=JSON.parse(localStorage.getItem('quizAnswers')||'[]');
  if(saved.length>0&&answers.length===0){answers=saved;current=Math.min(saved.length,questions.length-1);}
  document.getElementById('quizCard').innerHTML=`
    <div class="q-label">${q.label}</div>
    <div class="q-title">${q.title}</div>
    <div class="options-grid">
      ${q.options.map(o=>`<button class="option-btn${answers[current]===o.value?' selected':''}" onclick="selectOption('${o.value}')"><span class="option-icon">${o.icon}</span><span class="option-text">${o.text}</span></button>`).join('')}
    </div>
    <div class="quiz-nav">
      <button class="btn-back" onclick="prevQ()" ${current===0?'style="visibility:hidden"':''}>← Back</button>
      <button class="btn-next" id="nextBtn" onclick="nextQ()" ${!answers[current]?'disabled':''}>${current===questions.length-1?'See My Path →':'Next →'}</button>
    </div>`;
  renderSteps();
}

function selectOption(v){answers[current]=v;localStorage.setItem('quizAnswers',JSON.stringify(answers));renderQuestion();}
function nextQ(){if(!answers[current])return;if(current<questions.length-1){current++;renderQuestion();}else{showResults();}}
function prevQ(){if(current>0){current--;renderQuestion();}}

function showResults(){
  document.getElementById('quiz').style.display='none';
  const el=document.getElementById('results');el.style.display='block';
  quizProfile=getProfile(answers);
  const p=profiles[quizProfile];
  document.getElementById('profileBadge').textContent=p.badge;
  document.getElementById('resultsTitle').textContent=p.title;
  document.getElementById('resultsSubtitle').textContent=p.subtitle;
  document.getElementById('pathCards').innerHTML=p.paths.map(c=>`<div class="path-card"><div class="card-top" style="background:${c.color}"></div><div class="card-body"><div class="card-match">${c.match}</div><div class="card-title">${c.title}</div><div class="card-desc">${c.desc}</div><div class="card-tags">${c.tags.map(t=>`<span class="tag">${t}</span>`).join('')}</div></div></div>`).join('');
  document.getElementById('schoolsGrid').innerHTML=p.schools.map(s=>`<div class="school-card"><div class="school-rank">${s.rank}</div><div class="school-name">${s.name}</div><div class="school-city">📍 ${s.city}</div><span class="school-type">${s.type}</span></div>`).join('');
  document.getElementById('timeline').innerHTML=p.timeline.map(t=>`<div class="tl-item"><div class="tl-dot"></div><div class="tl-year">${t.year}</div><div class="tl-title">${t.title}</div><div class="tl-desc">${t.desc}</div></div>`).join('');
  document.getElementById('tipsGrid').innerHTML=p.tips.map(t=>`<div class="tip-card"><div class="tip-icon">${t.icon}</div><div class="tip-title">${t.title}</div><div class="tip-text">${t.text}</div></div>`).join('');
  el.scrollIntoView({behavior:'smooth'});initObserver();
  localStorage.removeItem('quizAnswers');
}

function restartQuiz(){
  current=0;answers=[];quizProfile=null;
  document.getElementById('results').style.display='none';
  document.getElementById('quiz').style.display='block';
  renderQuestion();
  document.getElementById('quiz').scrollIntoView({behavior:'smooth'});
}


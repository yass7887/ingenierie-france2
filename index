      <div class="gloss-term" onclick="toggleGloss(${i})">
        <div><div class="gloss-word">${g.term}</div><div class="gloss-en">${g.en}</div></div>
        <span class="gloss-chevron">▼</span>
      </div>
      <div class="gloss-def">${g.def}</div>
    </div>`).join('');
}
function toggleGloss(i){document.getElementById(`gi${i}`).classList.toggle('open');}
function filterGlossary(){
  const q=document.getElementById('glossSearch').value.toLowerCase();
  const filtered=glossary.filter(g=>g.term.toLowerCase().includes(q)||g.en.toLowerCase().includes(q)||g.def.toLowerCase().includes(q));
  renderGlossary(filtered);
}


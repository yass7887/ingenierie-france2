<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IngénieurFrance — Find Your Path</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --navy:#0a0f2e; --ink:#111827; --cream:#f5f0e8; --gold:#c9a84c; --gold-light:#e8c97a;
  --red:#c1392b; --blue:#1a3a6b; --green:#2d6a4f; --gray:#6b7280;
  --light:#f9f8f5; --white:#ffffff; --border:rgba(201,168,76,0.3);
  --card-bg:#ffffff; --section-bg:#f9f8f5; --text-muted:#6b7280;
}
body.dark {
  --cream:#0d1117; --light:#0d1117; --ink:#e6edf3; --gray:#8b949e;
  --white:#161b22; --card-bg:#161b22; --section-bg:#0d1117; --text-muted:#8b949e;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden;transition:background .3s,color .3s;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:.8rem 2rem;background:rgba(10,15,46,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(201,168,76,.12);}
.nav-logo{font-family:'Playfair Display',serif;font-size:1.15rem;color:#fff;text-decoration:none;}
.nav-logo span{color:var(--gold);}
.nav-links{display:flex;gap:1.6rem;align-items:center;}
.nav-links a{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.45);text-decoration:none;transition:color .2s;}
.nav-links a:hover{color:var(--gold);}
.nav-right{display:flex;gap:.8rem;align-items:center;}
.dark-toggle{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:.3rem .75rem;cursor:pointer;font-size:.8rem;color:rgba(255,255,255,.5);transition:all .2s;display:flex;align-items:center;gap:.35rem;}
.dark-toggle:hover{border-color:var(--gold);color:var(--gold);}

/* HERO */
#hero{min-height:100vh;background:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:2rem;padding-top:5rem;}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(201,168,76,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(201,168,76,.06) 1px,transparent 1px);background-size:60px 60px;}
.hero-glow{position:absolute;width:700px;height:700px;background:radial-gradient(circle,rgba(201,168,76,.1) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;}
.flag-bar{display:flex;gap:6px;margin-bottom:2rem;animation:fadeDown .8s ease both;}
.flag-bar span{display:block;width:36px;height:5px;border-radius:3px;}
.flag-bar .bleu{background:#002395;}.flag-bar .blanc{background:#ededed;}.flag-bar .rouge{background:#ED2939;}
.hero-label{font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:1.5rem;animation:fadeDown .9s ease .1s both;}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(3rem,8vw,6.5rem);font-weight:900;color:#fff;text-align:center;line-height:1.05;animation:fadeDown 1s ease .2s both;}
.hero-title em{font-style:italic;color:var(--gold);}
.hero-sub{max-width:520px;text-align:center;color:rgba(255,255,255,.52);font-size:1.05rem;line-height:1.7;margin-top:1.5rem;animation:fadeDown 1s ease .35s both;}
.hero-cta{margin-top:3rem;display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;animation:fadeDown 1s ease .5s both;}
.btn-primary{background:var(--gold);color:var(--navy);border:none;padding:.9rem 2.2rem;font-family:'DM Mono',monospace;font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;border-radius:3px;font-weight:500;transition:all .25s;text-decoration:none;display:inline-block;}
.btn-primary:hover{background:var(--gold-light);transform:translateY(-2px);box-shadow:0 8px 30px rgba(201,168,76,.35);}
.btn-outline{background:transparent;color:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.2);padding:.9rem 2.2rem;font-family:'DM Mono',monospace;font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;border-radius:3px;transition:all .25s;text-decoration:none;display:inline-block;}
.btn-outline:hover{border-color:var(--gold);color:var(--gold);}
.scroll-hint{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;color:rgba(255,255,255,.3);font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;animation:fadeIn 2s ease 1.2s both;}
.scroll-hint::after{content:'';display:block;width:1px;height:50px;background:linear-gradient(to bottom,rgba(201,168,76,.6),transparent);animation:scrollPulse 2s ease-in-out infinite;}

/* STATS */
.stats-strip{background:var(--blue);display:flex;justify-content:center;flex-wrap:wrap;}
.stat-item{flex:1;min-width:160px;max-width:280px;padding:2.5rem 2rem;text-align:center;border-right:1px solid rgba(255,255,255,.08);}
.stat-item:last-child{border-right:none;}
.stat-num{font-family:'Playfair Display',serif;font-size:2.8rem;font-weight:700;color:var(--gold);display:block;}
.stat-label{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.2em;color:rgba(255,255,255,.45);text-transform:uppercase;margin-top:.3rem;}

/* ABOUT */
#about{max-width:1100px;margin:0 auto;padding:7rem 2rem;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center;}
.section-tag{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:700;line-height:1.2;color:var(--navy);margin-bottom:1.5rem;}
body.dark .section-title{color:var(--ink);}
.section-body{font-size:1rem;line-height:1.8;color:var(--gray);}
.about-visual{background:var(--navy);border-radius:4px;padding:3rem 2.5rem;position:relative;overflow:hidden;}
.about-visual::before{content:'';position:absolute;top:-40px;right:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(201,168,76,.2),transparent 70%);}
.about-item{display:flex;align-items:flex-start;gap:1.2rem;margin-bottom:2rem;}
.about-item:last-child{margin-bottom:0;}
.about-icon{width:40px;height:40px;background:rgba(201,168,76,.15);border:1px solid var(--border);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.about-item h4{font-family:'Playfair Display',serif;font-size:1rem;color:#fff;margin-bottom:.3rem;}
.about-item p{font-size:.85rem;color:rgba(255,255,255,.42);line-height:1.6;}

/* QUIZ */
#quiz{background:var(--navy);padding:7rem 2rem;}
.quiz-wrap{max-width:760px;margin:0 auto;}
.quiz-header{text-align:center;margin-bottom:4rem;}
.quiz-header .section-title{color:#fff;}
.quiz-header .section-body{color:rgba(255,255,255,.42);max-width:480px;margin:0 auto;}
.steps{display:flex;justify-content:center;align-items:center;gap:0;margin-bottom:3.5rem;}
.step-dot{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:.7rem;color:rgba(255,255,255,.3);transition:all .3s;}
.step-dot.active{background:var(--gold);border-color:var(--gold);color:var(--navy);font-weight:700;}
.step-dot.done{background:rgba(201,168,76,.2);border-color:var(--gold);color:var(--gold);}
.step-line{width:40px;height:1px;background:rgba(255,255,255,.1);}
.quiz-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:3rem;}
.q-label{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.3em;color:var(--gold);text-transform:uppercase;margin-bottom:.8rem;}
.q-title{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:700;color:#fff;margin-bottom:2rem;line-height:1.3;}
.options-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:2.5rem;}
.option-btn{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:6px;padding:1rem 1.2rem;cursor:pointer;text-align:left;transition:all .2s;display:flex;align-items:center;gap:.8rem;}
.option-btn:hover{border-color:var(--gold);background:rgba(201,168,76,.08);}
.option-btn.selected{border-color:var(--gold);background:rgba(201,168,76,.15);}
.option-icon{font-size:1.3rem;}
.option-text{font-size:.9rem;color:rgba(255,255,255,.65);line-height:1.4;}
.option-btn.selected .option-text{color:#fff;}
.quiz-nav{display:flex;justify-content:space-between;align-items:center;}
.btn-back{background:transparent;border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.4);padding:.7rem 1.5rem;font-family:'DM Mono',monospace;font-size:.75rem;letter-spacing:.1em;cursor:pointer;border-radius:3px;transition:all .2s;}
.btn-back:hover{color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.3);}
.btn-next{background:var(--gold);border:none;color:var(--navy);padding:.8rem 2rem;font-family:'DM Mono',monospace;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;border-radius:3px;font-weight:500;transition:all .25s;}
.btn-next:hover{background:var(--gold-light);transform:translateY(-1px);}
.btn-next:disabled{opacity:.35;cursor:not-allowed;transform:none;}

/* RESULTS */
#results{display:none;padding:7rem 2rem;background:var(--section-bg);}
.results-wrap{max-width:1050px;margin:0 auto;}
.results-header{text-align:center;margin-bottom:5rem;}
.profile-badge{display:inline-flex;align-items:center;gap:.6rem;background:var(--navy);color:var(--gold);border-radius:100px;padding:.5rem 1.2rem;font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;margin-bottom:1.5rem;}
.path-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:1.5rem;margin-bottom:5rem;}
.path-card{background:var(--card-bg);border-radius:8px;overflow:hidden;border:1px solid rgba(0,0,0,.06);transition:all .25s;cursor:pointer;}
body.dark .path-card{border-color:rgba(255,255,255,.06);}
.path-card:hover{transform:translateY(-4px);box-shadow:0 20px 50px rgba(0,0,0,.1);}
.card-top{height:8px;}
.card-body{padding:2rem;}
.card-match{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.2em;color:var(--gray);text-transform:uppercase;margin-bottom:.4rem;}
.card-title{font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:var(--navy);margin-bottom:.6rem;}
body.dark .card-title{color:var(--ink);}
.card-desc{font-size:.87rem;color:var(--gray);line-height:1.65;margin-bottom:1.2rem;}
.card-tags{display:flex;flex-wrap:wrap;gap:.4rem;}
.tag{background:rgba(26,58,107,.07);color:var(--blue);border-radius:3px;padding:.25rem .6rem;font-size:.72rem;font-family:'DM Mono',monospace;}
body.dark .tag{background:rgba(201,168,76,.1);color:var(--gold);}

/* COMPARATOR */
#comparator{padding:7rem 2rem;background:var(--cream);}
body.dark #comparator{background:var(--navy);}
.comp-wrap{max-width:1100px;margin:0 auto;}
.comp-header{text-align:center;margin-bottom:3rem;}
.school-selector{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;margin-bottom:2.5rem;}
.school-chip{background:var(--card-bg);border:1px solid rgba(0,0,0,.1);border-radius:100px;padding:.45rem 1rem;font-size:.8rem;font-family:'DM Mono',monospace;cursor:pointer;transition:all .2s;color:var(--ink);}
body.dark .school-chip{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ink);}
.school-chip.active{background:var(--gold);border-color:var(--gold);color:var(--navy);}
.comp-table-wrap{overflow-x:auto;}
.comp-table{width:100%;border-collapse:collapse;}
.comp-table th{background:var(--navy);color:rgba(255,255,255,.7);font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;padding:1rem 1.2rem;text-align:left;white-space:nowrap;}
.comp-table td{padding:.9rem 1.2rem;border-bottom:1px solid rgba(0,0,0,.05);font-size:.88rem;color:var(--ink);background:var(--card-bg);}
body.dark .comp-table td{border-color:rgba(255,255,255,.04);}
.comp-table tr:hover td{background:rgba(201,168,76,.05);}
.score-bar{display:flex;align-items:center;gap:.6rem;}
.bar-track{flex:1;height:6px;background:rgba(0,0,0,.08);border-radius:3px;max-width:80px;}
body.dark .bar-track{background:rgba(255,255,255,.08);}
.bar-fill{height:100%;border-radius:3px;background:var(--gold);}
.badge-type{display:inline-block;background:rgba(193,57,43,.08);color:var(--red);border-radius:3px;padding:.2rem .5rem;font-size:.68rem;font-family:'DM Mono',monospace;}

/* SALARY CALC */
#salary{padding:7rem 2rem;background:var(--navy);}
.sal-wrap{max-width:800px;margin:0 auto;text-align:center;}
.sal-wrap .section-title{color:#fff;}
.sal-wrap .section-body{color:rgba(255,255,255,.42);}
.sal-controls{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin:3rem 0;}
.sal-group label{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:.8rem;}
.sal-group select{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:.8rem 1rem;color:#fff;font-family:'DM Sans',sans-serif;font-size:.9rem;cursor:pointer;appearance:none;}
.sal-group select option{background:#1a3a6b;color:#fff;}
.range-wrap{display:flex;align-items:center;gap:1rem;}
.sal-range{flex:1;appearance:none;height:4px;background:rgba(255,255,255,.15);border-radius:2px;outline:none;cursor:pointer;}
.sal-range::-webkit-slider-thumb{appearance:none;width:18px;height:18px;background:var(--gold);border-radius:50%;cursor:pointer;}
.range-val{font-family:'DM Mono',monospace;font-size:.85rem;color:var(--gold);min-width:30px;text-align:right;}
.sal-result{background:rgba(201,168,76,.1);border:1px solid var(--border);border-radius:10px;padding:2.5rem;margin-top:1rem;}
.sal-amount{font-family:'Playfair Display',serif;font-size:3.5rem;font-weight:700;color:var(--gold);}
.sal-desc{color:rgba(255,255,255,.45);font-size:.9rem;margin-top:.5rem;}
.sal-range-text{color:rgba(255,255,255,.3);font-family:'DM Mono',monospace;font-size:.72rem;margin-top:.4rem;letter-spacing:.1em;}

/* CONCOURS CALENDAR */
#calendar-section{padding:7rem 2rem;background:var(--section-bg);}
.cal-wrap{max-width:900px;margin:0 auto;}
.cal-header{margin-bottom:3rem;}
.events-list{display:flex;flex-direction:column;gap:1rem;}
.event-item{display:grid;grid-template-columns:120px 1fr auto;align-items:center;gap:1.5rem;background:var(--card-bg);border:1px solid rgba(0,0,0,.06);border-radius:8px;padding:1.5rem;transition:all .2s;}
body.dark .event-item{border-color:rgba(255,255,255,.06);}
.event-item:hover{border-color:var(--gold);}
.event-date-box{text-align:center;}
.event-month{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);}
.event-day{font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:700;color:var(--navy);line-height:1;}
body.dark .event-day{color:var(--ink);}
.event-year{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--gray);}
.event-info h4{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;color:var(--navy);margin-bottom:.3rem;}
body.dark .event-info h4{color:var(--ink);}
.event-info p{font-size:.82rem;color:var(--gray);}
.countdown-badge{font-family:'DM Mono',monospace;font-size:.72rem;background:rgba(193,57,43,.1);color:var(--red);border-radius:4px;padding:.35rem .7rem;white-space:nowrap;text-align:center;}
.countdown-badge.soon{background:rgba(201,168,76,.15);color:var(--gold);}
.countdown-badge.past{background:rgba(107,114,128,.1);color:var(--gray);}

/* CHECKLIST */
#checklist{padding:7rem 2rem;background:var(--navy);}
.check-wrap{max-width:750px;margin:0 auto;}
.check-header{text-align:center;margin-bottom:3rem;}
.check-header .section-title{color:#fff;}
.progress-bar-wrap{background:rgba(255,255,255,.08);border-radius:100px;height:8px;margin-bottom:.6rem;}
.progress-bar-fill{height:100%;border-radius:100px;background:linear-gradient(to right,var(--gold),var(--gold-light));transition:width .4s ease;}
.progress-text{font-family:'DM Mono',monospace;font-size:.68rem;color:rgba(255,255,255,.35);letter-spacing:.15em;margin-bottom:2.5rem;}
.check-categories{display:flex;flex-direction:column;gap:2rem;}
.check-cat{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;overflow:hidden;}
.check-cat-header{padding:1.2rem 1.5rem;background:rgba(255,255,255,.03);display:flex;align-items:center;gap:.8rem;cursor:pointer;}
.check-cat-icon{font-size:1.1rem;}
.check-cat-title{font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:#fff;}
.check-cat-count{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--gold);margin-left:auto;}
.check-items{padding:.5rem 1.5rem 1.2rem;}
.check-item{display:flex;align-items:center;gap:.9rem;padding:.7rem 0;border-bottom:1px solid rgba(255,255,255,.04);}
.check-item:last-child{border-bottom:none;}
.check-box{width:20px;height:20px;border:1.5px solid rgba(255,255,255,.2);border-radius:4px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .2s;background:transparent;}
.check-box.checked{background:var(--gold);border-color:var(--gold);}
.check-box.checked::after{content:'✓';font-size:.7rem;color:var(--navy);font-weight:700;}
.check-label{font-size:.88rem;color:rgba(255,255,255,.6);transition:all .2s;}
.check-item.done .check-label{text-decoration:line-through;color:rgba(255,255,255,.25);}

/* TESTIMONIALS */
#testimonials{padding:7rem 2rem;background:var(--section-bg);}
.testi-wrap{max-width:1100px;margin:0 auto;}
.testi-header{text-align:center;margin-bottom:4rem;}
.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;}
.testi-card{background:var(--card-bg);border-radius:10px;padding:2rem;border:1px solid rgba(0,0,0,.06);position:relative;}
body.dark .testi-card{border-color:rgba(255,255,255,.06);}
.testi-quote{font-size:3rem;color:var(--gold);opacity:.3;font-family:'Playfair Display',serif;line-height:1;margin-bottom:.5rem;}
.testi-text{font-size:.92rem;line-height:1.75;color:var(--gray);margin-bottom:1.5rem;font-style:italic;}
.testi-author{display:flex;align-items:center;gap:.8rem;}
.testi-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:700;font-family:'Playfair Display',serif;color:#fff;flex-shrink:0;}
.testi-name{font-weight:600;font-size:.9rem;color:var(--navy);}
body.dark .testi-name{color:var(--ink);}
.testi-role{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--gray);letter-spacing:.08em;}
.testi-school-tag{display:inline-block;margin-top:.6rem;background:rgba(201,168,76,.1);color:var(--gold);border-radius:3px;padding:.2rem .55rem;font-family:'DM Mono',monospace;font-size:.65rem;}

/* GLOSSARY */
#glossary{padding:7rem 2rem;background:var(--navy);}
.gloss-wrap{max-width:850px;margin:0 auto;}
.gloss-header{text-align:center;margin-bottom:3rem;}
.gloss-header .section-title{color:#fff;}
.gloss-search{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:1rem 1.2rem;color:#fff;font-family:'DM Sans',sans-serif;font-size:.95rem;outline:none;margin-bottom:2rem;transition:border-color .2s;}
.gloss-search::placeholder{color:rgba(255,255,255,.25);}
.gloss-search:focus{border-color:var(--gold);}
.gloss-items{display:flex;flex-direction:column;gap:.8rem;}
.gloss-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:6px;overflow:hidden;transition:border-color .2s;}
.gloss-item:hover{border-color:rgba(201,168,76,.3);}
.gloss-term{padding:1rem 1.3rem;display:flex;justify-content:space-between;align-items:center;cursor:pointer;}
.gloss-word{font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:#fff;}
.gloss-en{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--gold);letter-spacing:.12em;}
.gloss-chevron{color:rgba(255,255,255,.3);transition:transform .2s;font-size:.8rem;}
.gloss-item.open .gloss-chevron{transform:rotate(180deg);}
.gloss-def{display:none;padding:0 1.3rem 1rem;font-size:.87rem;color:rgba(255,255,255,.42);line-height:1.7;border-top:1px solid rgba(255,255,255,.05);}
